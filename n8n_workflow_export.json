{
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "process-lead",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        100,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/leads/enrich",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "aviara-secret"
            }
          ]
        },
        "sendBody": true,
        "bodyContentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\n  \"name\": \"{{ $json.body.name }}\",\n  \"email\": \"{{ $json.body.email }}\",\n  \"company\": \"{{ $json.body.company }}\"\n}",
        "options": {
          "retryOnFail": true,
          "maxRetries": 3,
          "waitBetweenRetries": 5000
        }
      },
      "id": "enrich-request",
      "name": "Enrich Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        350,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/leads/classify",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "aviara-secret"
            }
          ]
        },
        "sendBody": true,
        "bodyContentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\n  \"name\": \"{{ $node[\"Webhook Trigger\"].json.body.name }}\",\n  \"email\": \"{{ $node[\"Webhook Trigger\"].json.body.email }}\",\n  \"company\": \"{{ $node[\"Webhook Trigger\"].json.body.company }}\",\n  \"message\": \"{{ $node[\"Webhook Trigger\"].json.body.message }}\"\n}",
        "options": {
          "retryOnFail": true,
          "maxRetries": 3,
          "waitBetweenRetries": 5000
        }
      },
      "id": "classify-request",
      "name": "Classify Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        600,
        200
      ]
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": "public",
        "table": "leads",
        "columns": [
          "name",
          "email",
          "company",
          "industry",
          "company_size",
          "linkedin_url",
          "intent",
          "confidence",
          "message"
        ],
        "options": {}
      },
      "id": "postgres-node",
      "name": "PostgreSQL",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        850,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "enter_your_slack_webhook_url",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": \"🔥 *New Lead Processed*\\n*Name:* {{ $node[\\\"Webhook Trigger\\\"].json.body.name }}\\n*Intent:* {{ $node[\\\"Classify Lead\\\"].json.intent }}\\n*Confidence:* {{ $node[\\\"Classify Lead\\\"].json.confidence * 100 }}%\"\n}",
        "options": {}
      },
      "id": "slack-webhook",
      "name": "Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1100,
        200
      ]
    },
    {
      "parameters": {},
      "id": "error-trigger",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        100,
        450
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "enter_your_slack_url",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": \"🚨 *DEAD LETTER QUEUE ALERT* 🚨\\nLead processing failed after multiple retries.\\n*Node:* {{ $json.execution.error.node.name }}\\n*Error:* {{ $json.execution.error.message }}\"\n}",
        "options": {}
      },
      "id": "dlq-alert",
      "name": "DLQ Slack Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        350,
        450
      ]
    }
  ],
  "connections": {
